{
  "name": "claimpilot",
  "version": "0.1.0",
  "description": "ClaimPilot — Cross-Platform Desktop AI Employee for Corporate & Personal Obligations",
  "author": "ClaimPilot Engineering Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite build && electron dist-electron/main.js",
    "package:mac": "vite build && electron-builder --mac",
    "package:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.claimpilot.desktop",
    "productName": "ClaimPilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "executableName": "ClaimPilot",
      "sign": null,
      "signAndEditExecutable": false,
      "target": [
        "dir"
      ]
    }
  }
}
